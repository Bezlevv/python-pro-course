# Пример конфигурации через переменные окружения.
# Скопируй в .env (или задай переменные в Docker/CI).

# Секретный ключ Django — обязательно замени в продакшене!
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# DEBUG=true для разработки, false для продакшена
DJANGO_DEBUG=false

# Разрешённые хосты через запятую: localhost,127.0.0.1,example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com

# База данных: sqlite (по умолчанию) или postgresql
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=pythonpro
# DJANGO_DB_USER=pythonpro
# DJANGO_DB_PASSWORD=pythonpro
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
# Путь к файлу sqlite (если используете sqlite)
# DJANGO_DB_PATH=/app/db.sqlite3

# Redis для кэша (если не задан — встроенный LocMemCache)
# DJANGO_REDIS_URL=redis://127.0.0.1:6379/1

# Telegram-бот (см. bot/telegram_bot.py)
# TG_BOT_TOKEN=123456:ABC...
# TG_BOT_REMIND_HOUR=19
